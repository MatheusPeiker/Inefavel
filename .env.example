# Número do WhatsApp da loja (DDI + DDD + número, só dígitos). Pode ser alterado depois no Admin > Configurações.
VITE_WHATSAPP_NUMBER=5511999999999

# PIN do admin enquanto o app roda sem Supabase (modo demonstração, dados no navegador).
VITE_ADMIN_PIN=1234

# Preencha para usar o Supabase (banco, fotos e login do admin). Veja supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
